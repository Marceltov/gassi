# --- Required ---
# Base URL, used for the redirect URI (${PUBLIC_URL}/api/oidc/callback) and the cookies' Secure flag.
PUBLIC_URL=https://gassi.herziis.de
# HMAC key for the cookies, at least 32 characters: openssl rand -hex 32
SECRET=
# From the authentik OAuth2/OpenID provider "gassi".
OIDC_ISSUER=https://auth.herziis.de/application/o/gassi/
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# --- Optional ---
# Name of the dog created on first start.
DOG_NAME=Toffee
# Holds gassi.db (/data in the image).
DATA_DIR=./data
# What "today" and displayed times mean.
TZ=Europe/Berlin
# When set, enables the bearer-token REST API under /api/v1/entries.
API_TOKEN=
# pino level: fatal, error, warn, info, debug, trace, silent
LOG_LEVEL=info
