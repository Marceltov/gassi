{
  "expo": {
    "name": "Gassi",
    "slug": "gassi",
    "version": "0.3.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "gassi",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "io.github.marceltov.gassi",
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#2f6b45",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "lang": "de",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "asyncRoutes": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#111418"
        }
      ],
      "expo-sqlite",
      "expo-web-browser",
      "@maplibre/maplibre-react-native",
      [
        "expo-location",
        {
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true,
          "locationWhenInUsePermission": "Gassi zeichnet die Strecke der Runde auf.",
          "locationAlwaysAndWhenInUsePermission": "Gassi zeichnet die Strecke der Runde auch bei ausgeschaltetem Bildschirm auf."
        }
      ],
      "expo-task-manager",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "backgroundColor": "#111418",
    "owner": "marceltov-gassi",
    "extra": {
      "eas": {
        "projectId": "64643fb1-a3e3-408f-9b6a-d3eba04ebfac"
      }
    },
    "runtimeVersion": "2",
    "updates": {
      "url": "https://gassi.herziis.de/api/updates/manifest",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "codeSigningCertificate": "./certs/certificate.pem",
      "codeSigningMetadata": {
        "keyid": "main",
        "alg": "rsa-v1_5-sha256"
      },
      "disableAntiBrickingMeasures": true
    }
  }
}
