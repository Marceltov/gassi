# --- Required ---
# The address the apps reach this server at (links and the OIDC redirect URI are built from it).
PUBLIC_URL=http://localhost:3000

# --- Optional ---
# Sign-in links by e-mail ("magic links"): smtp://user:pass@host:587 or smtps://user:pass@host:465
SMTP_URL=
# Sender of those mails (default gassi@<host of PUBLIC_URL>)
MAIL_FROM=
# Sign-in through your identity provider: all three or none. With it, new people come in through the provider.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# "Wünsche und Fehler" in Mehr: the repo's GitHub issues and a form to file one. Both or none; the token is fine-grained,
# with read and write access to this repo's issues only.
FEEDBACK_GITHUB_REPO=
FEEDBACK_GITHUB_TOKEN=
# The first dog's name when the setup doesn't ask (and for the first OIDC sign-in)
DOG_NAME=
# Holds gassi.db, its backups and the cookie key (/data in the image)
DATA_DIR=./data
# What a day and a week mean
TZ=Europe/Berlin
# A fixed key for signed cookies (at least 32 characters); else one is kept in DATA_DIR
SECRET=
# pino level: fatal, error, warn, info, debug, trace, silent
LOG_LEVEL=info
# What is kept of the app's events (errors, screens, taps, sync and recording health, 30 days): all, errors or off
CLIENT_EVENTS=all
# Development only: the Expo dev server's origin (npm run web -w @gassi/mobile), allowed to call /api/* from there
CORS_ORIGIN=
