{
  "name": "gassi",
  "version": "0.3.0",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/mobile",
    "apps/server"
  ],
  "scripts": {
    "lint": "eslint",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:e2e": "npm run build:app && npm run test:e2e --workspaces --if-present",
    "build:app": "node scripts/web.mjs",
    "runtime:check": "node scripts/runtime.mjs",
    "runtime:record": "node scripts/runtime.mjs record",
    "build": "npm run build:app && npm run build -w @gassi/server"
  },
  "devDependencies": {
    "@types/node": "^22",
    "eslint": "^9",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
